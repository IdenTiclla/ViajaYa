# Hosted testing contract. Replace placeholders in a private secrets store.
# This file contains no working provider credentials and is never a secrets file.
APP_ENV=testing
PUBLIC_API_URL=https://api-testing.example.invalid/api/v1
DATABASE_URL=postgresql+asyncpg://viajaya:replace-me@database-testing.internal/viajaya_testing
JWT_SECRET=replace-me-with-a-distinct-random-secret-of-at-least-32-bytes
JWT_ISSUER=viajaya:testing
JWT_AUDIENCE=viajaya:mobile:testing
CORS_ORIGINS=https://admin-testing.example.invalid
STORAGE_NAMESPACE=viajaya-testing
REALTIME_REDIS_URL=rediss://cache-testing.internal:6379/0
REALTIME_REDIS_CHANNEL=viajaya:testing:realtime:v2
REALTIME_PRESENCE_KEY_PREFIX=viajaya:testing:presence:v1
OTP_MODE=mock
OTP_TEST_AUTOFILL=true
# Testing approves driver applications at once; operator review arrives with F04-A.
DRIVER_AUTO_APPROVE=true
PAYMENT_MODE=sandbox
EMAIL_MODE=mock
PUSH_MODE=mock
# Keep technical rollout flags off until the existing rollout procedure is certified.
REALTIME_OUTBOX_DISPATCH_MODE=off
REALTIME_OUTBOX_RECORDING_ENABLED=false
REALTIME_SHARED_PRESENCE_ENABLED=false
SCHEDULED_ACTIONS_MODE=off
