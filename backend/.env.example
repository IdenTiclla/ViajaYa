# PostgreSQL (async driver)
DATABASE_URL=postgresql+asyncpg://viajaya:viajaya@localhost:5432/viajaya

# JWT
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# CORS (orígenes separados por coma)
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# OAuth - Google
GOOGLE_CLIENT_ID=

# OAuth - Facebook
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Outbox realtime
# Secuencia segura: off+false -> shadow+false -> shadow+true -> live_local+true.
# `shadow` solo valida y marca batches. Antes de `live_local`, drena y comprueba
# que no quede backlog pendiente. `live_local` entrega v2 al hub de este proceso,
# desactiva la ruta legacy y exige EXACTAMENTE un worker API; no habilita Redis
# ni un despliegue multiworker.
# Requiere aplicar 0018_realtime_outbox, 0019_realtime_stream_versions y
# 0020_realtime_outbox_quarantine.
REALTIME_OUTBOX_DISPATCH_MODE=off
REALTIME_OUTBOX_RECORDING_ENABLED=false
REALTIME_OUTBOX_POLL_INTERVAL_SECONDS=1
REALTIME_OUTBOX_RETRY_BASE_SECONDS=1
REALTIME_OUTBOX_RETRY_MAX_SECONDS=60
REALTIME_OUTBOX_SHUTDOWN_TIMEOUT_SECONDS=5
