# Local development only. Hosted contracts live in ops/environments/*.env.example.
# Keep each deployment's secrets outside source control and outside Docker images.
APP_ENV=development
PUBLIC_API_URL=http://localhost:8000/api/v1
JWT_ISSUER=viajaya:development
JWT_AUDIENCE=viajaya:mobile:development
STORAGE_NAMESPACE=viajaya-development

# Provider contracts: phone entry uses mock OTP here; real SMS follows in F02-C.
# Never configure OTP provider credentials in development or testing.
OTP_MODE=mock
OTP_TEST_AUTOFILL=true
# Apply migration 0025 before enabling the phone entry flow.
PHONE_OTP_ENABLED=false
PHONE_OTP_ALLOWED_REGIONS=["BO"]
PHONE_OTP_TTL_SECONDS=300
PHONE_TERMS_VERSION=testing-2026-09
# Driver applications are approved at once here; hosted environments review them (F04-A).
DRIVER_AUTO_APPROVE=true
# Testing conditions are configured in Settings; production legal terms are a separate release gate.
PAYMENT_MODE=mock
EMAIL_MODE=mock
PUSH_MODE=mock
NOTIFICATION_TEST_RECIPIENTS=

# Existing local defaults. For a physical phone, allow its development server origin.
DATABASE_URL=postgresql+asyncpg://viajaya:viajaya@localhost:5432/viajaya
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Expose metrics only behind the monitoring perimeter.
OPENMETRICS_ENABLED=false

# Preserve the staged rollout: off+false -> shadow+false -> shadow+true
# -> live_local+true -> live_redis+true. Both live modes disable legacy delivery.
# Apply migrations 0018 through 0023 before enabling the relevant workers.
# Multiworker requires shared presence, scheduler live, and an inspected/drained backlog.
REALTIME_OUTBOX_DISPATCH_MODE=off
REALTIME_OUTBOX_RECORDING_ENABLED=false
REALTIME_OUTBOX_POLL_INTERVAL_SECONDS=1
REALTIME_OUTBOX_RETRY_BASE_SECONDS=1
REALTIME_OUTBOX_RETRY_MAX_SECONDS=60
REALTIME_OUTBOX_SHUTDOWN_TIMEOUT_SECONDS=5

# Redis is transient fanout; PostgreSQL owns durable recovery and snapshots.
REALTIME_REDIS_URL=redis://localhost:6379/0
REALTIME_REDIS_CHANNEL=viajaya:realtime:v2
REALTIME_REDIS_CONNECT_TIMEOUT_SECONDS=2
REALTIME_REDIS_RECONNECT_BASE_SECONDS=0.5
REALTIME_REDIS_RECONNECT_MAX_SECONDS=30

# Deploy the shared presence flag off first. Enable only after live_redis,
# recording=true, and scheduler live are active. Keep passenger grace at 120 seconds.
REALTIME_SHARED_PRESENCE_ENABLED=false
REALTIME_PRESENCE_KEY_PREFIX=viajaya:presence:v1
REALTIME_PRESENCE_LEASE_SECONDS=30
REALTIME_PRESENCE_RENEW_INTERVAL_SECONDS=10
REALTIME_PRESENCE_GRACE_SECONDS=120
REALTIME_PRESENCE_RECHECK_SECONDS=5

# Retention is opt-in: zero keeps published batches. Never purge pending,
# retrying, or quarantined batches or the counters used by stream watermarks.
REALTIME_OUTBOX_PUBLISHED_RETENTION_DAYS=0
REALTIME_OUTBOX_RETENTION_INTERVAL_SECONDS=3600
REALTIME_OUTBOX_RETENTION_BATCH_LIMIT=100

# Migration 0022 is required. Off preserves local timers; shadow runs both;
# live uses the durable worker and requires a live outbox. Preserve the rollout.
SCHEDULED_ACTIONS_MODE=off
SCHEDULED_ACTIONS_POLL_INTERVAL_SECONDS=1
SCHEDULED_ACTIONS_LEASE_SECONDS=30
SCHEDULED_ACTIONS_HANDLER_TIMEOUT_SECONDS=10
SCHEDULED_ACTIONS_MAX_ATTEMPTS=5
SCHEDULED_ACTIONS_RETRY_BASE_SECONDS=1
SCHEDULED_ACTIONS_RETRY_MAX_SECONDS=60
SCHEDULED_ACTIONS_SHUTDOWN_TIMEOUT_SECONDS=12

# Purge successful/cancelled actions; keep dead actions for diagnostics.
SCHEDULED_ACTIONS_TERMINAL_RETENTION_DAYS=30
SCHEDULED_ACTIONS_RETENTION_INTERVAL_SECONDS=60
SCHEDULED_ACTIONS_RETENTION_BATCH_LIMIT=1000
