# Production contract. Placeholders intentionally fail startup validation.
APP_ENV=production
PUBLIC_API_URL=https://api.example.invalid/api/v1
DATABASE_URL=postgresql+asyncpg://viajaya:replace-me@database-production.internal/viajaya_production
JWT_SECRET=replace-me-with-a-distinct-random-secret-of-at-least-32-bytes
JWT_ISSUER=viajaya:production
JWT_AUDIENCE=viajaya:mobile:production
CORS_ORIGINS=https://admin.example.invalid
STORAGE_NAMESPACE=viajaya-production
REALTIME_REDIS_URL=rediss://cache-production.internal:6379/0
REALTIME_REDIS_CHANNEL=viajaya:production:realtime:v2
REALTIME_PRESENCE_KEY_PREFIX=viajaya:production:presence:v1
OTP_MODE=provider
OTP_TEST_AUTOFILL=false
PAYMENT_MODE=live
EMAIL_MODE=live
PUSH_MODE=live
# Provider implementation and credentials are added with F02/F07 and certified in F09.
# Never skip the existing shadow/live rollout procedure to enable multiple workers.
REALTIME_OUTBOX_DISPATCH_MODE=off
REALTIME_OUTBOX_RECORDING_ENABLED=false
REALTIME_SHARED_PRESENCE_ENABLED=false
SCHEDULED_ACTIONS_MODE=off
