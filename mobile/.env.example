# Exact application environment: development, testing, production.
# EAS profiles set this explicitly; NODE_ENV does not select a deployment.
APP_ENV=development

# Development only. Use the backend LAN IP for physical phones.
API_URL=http://localhost:8000/api/v1
OTP_TEST_AUTOFILL=true

# Public Maps keys. Restrict them by application, signing certificate, and API.
GOOGLE_MAPS_API_KEY_IOS=
GOOGLE_MAPS_API_KEY_ANDROID=

# Public Google OAuth client IDs by platform.
GOOGLE_OAUTH_CLIENT_ID_IOS=
GOOGLE_OAUTH_CLIENT_ID_ANDROID=
GOOGLE_OAUTH_CLIENT_ID_WEB=

# Facebook OAuth (public app id and client token; the app secret stays in the API)
FACEBOOK_APP_ID=
FACEBOOK_CLIENT_TOKEN=

# Set these public values in EAS preview for APP_ENV=testing.
# Local unprefixed values are never a fallback for hosted variants.
TESTING_API_URL=https://api-testing.example.invalid/api/v1
TESTING_OTP_TEST_AUTOFILL=true
TESTING_GOOGLE_MAPS_API_KEY_IOS=
TESTING_GOOGLE_MAPS_API_KEY_ANDROID=
TESTING_GOOGLE_OAUTH_CLIENT_ID_IOS=
TESTING_GOOGLE_OAUTH_CLIENT_ID_ANDROID=
TESTING_GOOGLE_OAUTH_CLIENT_ID_WEB=
TESTING_FACEBOOK_APP_ID=
TESTING_FACEBOOK_CLIENT_TOKEN=

# Set these in EAS production for APP_ENV=production.
PRODUCTION_API_URL=https://api.example.invalid/api/v1
PRODUCTION_OTP_TEST_AUTOFILL=false
PRODUCTION_GOOGLE_MAPS_API_KEY_IOS=
PRODUCTION_GOOGLE_MAPS_API_KEY_ANDROID=
PRODUCTION_GOOGLE_OAUTH_CLIENT_ID_IOS=
PRODUCTION_GOOGLE_OAUTH_CLIENT_ID_ANDROID=
PRODUCTION_GOOGLE_OAUTH_CLIENT_ID_WEB=
PRODUCTION_FACEBOOK_APP_ID=
PRODUCTION_FACEBOOK_CLIENT_TOKEN=

# Everything bundled in mobile is public. Never add JWT, SMS, PSP, or OAuth secrets.
