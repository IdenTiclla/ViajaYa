# PostgreSQL (async driver)
DATABASE_URL=postgresql+asyncpg://viajaya:viajaya@localhost:5432/viajaya

# JWT
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# CORS (orígenes separados por coma)
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# OAuth - Google
GOOGLE_CLIENT_ID=

# OAuth - Facebook
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Endpoint /metrics. Habilítalo solo detrás de la red interna de monitoreo.
OPENMETRICS_ENABLED=false

# Outbox realtime
# Secuencia segura: off+false -> shadow+false -> shadow+true -> live_local+true
# -> live_redis+true. `shadow` valida y marca; `live_local` entrega v2 solo al hub
# del proceso; `live_redis` publica el batch a todos los hubs locales suscritos.
# La clave advisory legada impide mezclar binarios durante rolling deploy.
# live_local siempre usa un worker; live_redis solo comparte el lock cuando el
# flag de presencia y el scheduler durable están activos. Ambos modos live
# desactivan la ruta legacy.
# Requiere aplicar 0018_realtime_outbox, 0019_realtime_stream_versions y
# 0020_realtime_outbox_quarantine. Los consumidores y la retención actuales
# requieren además 0021_realtime_outbox_batch_size. Aplica también
# 0023_outbox_correlation_id antes de desplegar este productor.
REALTIME_OUTBOX_DISPATCH_MODE=off
REALTIME_OUTBOX_RECORDING_ENABLED=false
REALTIME_OUTBOX_POLL_INTERVAL_SECONDS=1
REALTIME_OUTBOX_RETRY_BASE_SECONDS=1
REALTIME_OUTBOX_RETRY_MAX_SECONDS=60
REALTIME_OUTBOX_SHUTDOWN_TIMEOUT_SECONDS=5

# Fanout efímero entre procesos. PostgreSQL sigue siendo la fuente durable y un
# corte de Pub/Sub cierra sockets con 1012 para forzar snapshot autoritativo.
REALTIME_REDIS_URL=redis://localhost:6379/0
REALTIME_REDIS_CHANNEL=viajaya:realtime:v2
REALTIME_REDIS_CONNECT_TIMEOUT_SECONDS=2
REALTIME_REDIS_RECONNECT_BASE_SECONDS=0.5
REALTIME_REDIS_RECONNECT_MAX_SECONDS=30

# Presencia compartida. Despliega primero este código con false en todas las
# réplicas; luego exige live_redis + recording=true + SCHEDULED_ACTIONS_MODE=live
# antes de activar el flag. Cada conexión WS tiene su lease; HTTP renueva su
# propio pulso y cancel_absent_ride confirma Redis antes de cerrar la búsqueda.
REALTIME_SHARED_PRESENCE_ENABLED=false
REALTIME_PRESENCE_KEY_PREFIX=viajaya:presence:v1
REALTIME_PRESENCE_LEASE_SECONDS=30
REALTIME_PRESENCE_RENEW_INTERVAL_SECONDS=10
REALTIME_PRESENCE_GRACE_SECONDS=120
REALTIME_PRESENCE_RECHECK_SECONDS=5

# Retención opt-in de batches publicados. 0 conserva todo y no inicia el worker.
# Antes de activarla, observa /health/realtime y define el TTL operativo; por
# ejemplo, 30 días. Nunca elimina pendientes, reintentos, cuarentenas ni los
# contadores que alimentan los watermarks v2.
REALTIME_OUTBOX_PUBLISHED_RETENTION_DAYS=0
REALTIME_OUTBOX_RETENTION_INTERVAL_SECONDS=3600
REALTIME_OUTBOX_RETENTION_BATCH_LIMIT=100

# Acciones programadas durables (requiere migración 0022).
# Aplicar 0022 antes de desplegar este backend. Todos los modos escriben la acción:
# off conserva solo el timer local; shadow ejecuta worker + timer y entrega legacy;
# live reemplaza el timer y exige outbox live_local|live_redis + recording=true;
# también consume cancel_absent_ride al activar presencia compartida.
# El arranque y cada ciclo consumidor reconcilian ofertas y búsquedas sin acción
# durable creadas durante un rolling deploy.
SCHEDULED_ACTIONS_MODE=off
SCHEDULED_ACTIONS_POLL_INTERVAL_SECONDS=1
SCHEDULED_ACTIONS_LEASE_SECONDS=30
SCHEDULED_ACTIONS_HANDLER_TIMEOUT_SECONDS=10
SCHEDULED_ACTIONS_MAX_ATTEMPTS=5
SCHEDULED_ACTIONS_RETRY_BASE_SECONDS=1
SCHEDULED_ACTIONS_RETRY_MAX_SECONDS=60
SCHEDULED_ACTIONS_SHUTDOWN_TIMEOUT_SECONDS=12
# Retención obligatoria de succeeded/cancelled; las acciones dead nunca se borran.
SCHEDULED_ACTIONS_TERMINAL_RETENTION_DAYS=30
SCHEDULED_ACTIONS_RETENTION_INTERVAL_SECONDS=60
SCHEDULED_ACTIONS_RETENTION_BATCH_LIMIT=1000
